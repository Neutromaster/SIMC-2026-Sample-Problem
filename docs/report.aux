\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Monte Carlo (markers) versus closed form (lines) across the $(N, p)$ plane. Left panel: $\langle S\rangle = N(2p-1)^{2}$. Right panel: $\sigma _N = \sqrt  {N[1-(2p-1)^{4}]}$. The markers are the empirical $\hat  \mu _{\mathrm  {MC}}$ and $\hat  \sigma _{\mathrm  {MC}}$ with $M = 2\times 10^{5}$ pairs per cell. All $25$ cells agree to within sampling noise.}}{14}{figure.caption.17}\protected@file@percent }
\newlabel{fig:task6-grid}{{6}{14}{Monte Carlo (markers) versus closed form (lines) across the $(N, p)$ plane. Left panel: $\langle S\rangle = N(2p-1)^{2}$. Right panel: $\sigma _N = \sqrt {N[1-(2p-1)^{4}]}$. The markers are the empirical $\hat \mu _{\mathrm {MC}}$ and $\hat \sigma _{\mathrm {MC}}$ with $M = 2\times 10^{5}$ pairs per cell. All $25$ cells agree to within sampling noise}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Distribution of $S$ under the null at $(N, p) = (100, 0.5)$. Blue bars: $10^{6}$ Monte Carlo samples. Red markers: exact shifted-binomial PMF $S = 2T-N$ with $T \sim \mathrm  {Binomial}(N,q)$, $q = p^{2}+(1-p)^{2}$. Black curve: CLT Gaussian $\mathcal  {N}(0,\,100)$. The three agree to graphical precision, which validates Task~7's Gaussian $p$-value at $N=100$.}}{15}{figure.caption.18}\protected@file@percent }
\newlabel{fig:task6-distribution}{{7}{15}{Distribution of $S$ under the null at $(N, p) = (100, 0.5)$. Blue bars: $10^{6}$ Monte Carlo samples. Red markers: exact shifted-binomial PMF $S = 2T-N$ with $T \sim \mathrm {Binomial}(N,q)$, $q = p^{2}+(1-p)^{2}$. Black curve: CLT Gaussian $\mathcal {N}(0,\,100)$. The three agree to graphical precision, which validates Task~7's Gaussian $p$-value at $N=100$}{figure.caption.18}{}}
